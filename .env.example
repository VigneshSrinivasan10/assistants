# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
# 1. Create an app in the Spotify Developer Dashboard
# 2. Copy your Client ID and Client Secret
# 3. Add http://localhost:8888/callback to your app's Redirect URIs

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: Weather API key (if using WeatherAPI.com instead of Open-Meteo)
# WEATHERAPI_KEY=your_weather_api_key_here

# Optional: Logging configuration
# LOG_LEVEL=INFO
# SUPPRESS_LOGGERS=httpx,httpcore
